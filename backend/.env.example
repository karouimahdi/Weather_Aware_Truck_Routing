# Django
SECRET_KEY=change-me-to-a-random-value-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OSRM (routing) — public demo server, no key needed.
# No truck/HGV profile available on this provider (generic car routing only).
OSRM_BASE_URL=https://router.project-osrm.org

# Nominatim (geocoding) — no key needed. Requires an identifying User-Agent
# (set in integrations/routing_client.py), per Nominatim's usage policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Open-Meteo (weather) — no key required
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
